# Copy to .env.local (never commit .env.local).

# The live workbook. Defaults to La Cabra's master copy workbook.
GOOGLE_SHEET_ID=1Kt4x-vf3oDdrQplwE7yW6TrDfTvtm55mOJK3yCpWvFo

# How the app reaches the Sheet: oauth (sign in with your Google account) or service_account.
GOOGLE_AUTH_MODE=oauth

# OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID → "Web application",
# authorised redirect URI: http://localhost:3100/api/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Service account alternative: path to the JSON key, kept OUTSIDE this folder (e.g. ~/.la-cabra-ad-copy-studio/secrets/).
# Share the workbook with the service account's email as Editor (do not publish the Sheet).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# readwrite (default) or readonly. readonly requests the spreadsheets.readonly scope and disables write-back.
GOOGLE_ACCESS=readwrite

# Optional: where the SQLite database, sandbox workbook, backups and tokens live.
# Default: ~/.la-cabra-ad-copy-studio (outside this folder). Do not point it inside this folder while using `npm run dev`.
# STUDIO_DATA_DIR=

# Optional, for previewing in a trusted remote environment only: extra host names the server may answer on
# (comma-separated, or * for any). Leave empty on your own computer — the default is localhost only.
# STUDIO_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------------------------
# ONLINE VERSION (Vercel + Supabase). Leave these empty on the Mac.
# Setting DATABASE_URL switches storage to Supabase Postgres AND requires Google sign-in.
# Supabase → Project → Connect → "Session pooler" connection string (port 5432):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# STUDIO_DB_SCHEMA=ad_studio
# Supabase → Project Settings → API:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
# Who may sign in (Google accounts on these domains, plus named addresses):
# STUDIO_ALLOWED_EMAIL_DOMAINS=lacabra.com
# STUDIO_ALLOWED_EMAILS=
# NEXT_PUBLIC_STUDIO_SIGNIN_DOMAIN=lacabra.com   # pre-selects La Cabra accounts on Google's screen
# Reading the live Sheet online uses a Google service account (share the Sheet with its email as Viewer):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

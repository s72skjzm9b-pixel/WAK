# Copy to .env.local (never commit real values).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never paste into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the app (used in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (parent consent + trip permission emails)
RESEND_API_KEY=
EMAIL_FROM="WAK <hej@your-domain.dk>"

# Optional
# CHILD_LOGIN_EMAIL_DOMAIN=konto.wak.invalid   # internal login address for children's usernames
# WAK_POLICY_VERSION=2026-11-draft             # stored with every consent
# WAK_DEV_OUTBOX=./.wak-outbox.jsonl           # dev: write emails to a file instead of sending
